[Unit]
Description=Smart Warehouse MySQL API Service (SV3 - De tai 22)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=wh_service
Group=wh_service
WorkingDirectory=/opt/smart_warehouse_api
ExecStart=/usr/bin/python3 /opt/smart_warehouse_api/app.py
Restart=always
RestartSec=5s
Environment=PYTHONUNBUFFERED=1
StandardOutput=append:/var/log/smart_warehouse/api.log
StandardError=append:/var/log/smart_warehouse/api_error.log

# Bảo mật tầng hệ điều hành (OS Layer Hardening)
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
